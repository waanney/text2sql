      "phrase": "list the names and DOC type of schools which has a difference above this average",
      "column": "frpm.School Name",
      "operator": "IN",
      "value": "(SELECT frpm.School Name FROM frpm JOIN schools ON frpm.CDSCode = schools.CDSCode WHERE frpm.Charter Funding Type = 'Locally funded' AND (frpm.Enrollment (K-12) - frpm.Enrollment (Ages 5-17)) > (SELECT AVG(frpm.Enrollment (K-12) - frpm.Enrollment (Ages 5-17)) FROM frpm JOIN schools ON frpm.CDSCode = schools.CDSCode WHERE frpm.Charter Funding Type = 'Locally funded'))",
