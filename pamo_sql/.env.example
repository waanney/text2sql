# ==============================================================================
# PAMO-SQL V2 Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Option A: Using Official OpenAI API
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# Option B: Using Local LLMs (Ollama, vLLM, LM Studio, etc.)
# For Ollama running locally on host:
OPENAI_API_BASE=http://host.docker.internal:11434/v1
# For vLLM running locally on host:
# OPENAI_API_BASE=http://host.docker.internal:8000/v1

OPENAI_MODEL=qwen2.5-coder:7b
OPENAI_API_KEY=local-model-token

# ------------------------------------------------------------------------------
# Pipeline & Logging Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FORMAT: 'json' (highly recommended for real-time monitoring via Dozzle) or 'text'
LOG_FORMAT=json
LOG_DIR=/app/artifacts/logs

# ------------------------------------------------------------------------------
# Project Directory Paths (Relative to container workspace)
# ------------------------------------------------------------------------------
PYTHONPATH=/app
